# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/keeper_ai?schema=public"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-string"
# Public URL of the app (no trailing slash)
AUTH_URL="http://localhost:3000"

# Google OAuth (same project: enable Drive API + Calendar API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini (Google AI Studio API key)
GEMINI_API_KEY=""
# Optional overrides (defaults used in code)
GEMINI_MODEL_FLASH="gemini-2.0-flash"
GEMINI_MODEL_PRO="gemini-2.0-pro"
# Byte threshold to prefer Pro over Flash (default 5_000_000)
GEMINI_PRO_BYTE_THRESHOLD="5000000"

# Cron worker (protect /api/cron/process-jobs)
CRON_SECRET="replace-with-random-string"

# Raw uploads — local dev only (filesystem). On Vercel, files go to Blob when token is set.
STORAGE_ROOT="./uploads"

# Vercel Blob (Production on Vercel): create/link Blob store in Vercel → env BLOB_READ_WRITE_TOKEN
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Optional: AES-256-GCM key (32 bytes base64) for encrypting OAuth tokens at rest
# If unset, tokens are stored as returned by Google (still server-side only).
TOKEN_ENCRYPTION_KEY=""
